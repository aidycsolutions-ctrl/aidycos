Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo_source = Image("/usr/share/plymouth/themes/aidycos/AidyCOS.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
logo_size = screen_height * 0.56;
if (logo_size > screen_width * 0.85) {
    logo_size = screen_width * 0.85;
}
logo_image = logo_source.Scale(logo_size, logo_size);
logo_sprite = Sprite(logo_image);
logo_x = screen_width / 2 - logo_image.GetWidth() / 2;
logo_y = screen_height / 2 - logo_image.GetHeight() / 2;
logo_sprite.SetPosition(logo_x, logo_y, 0);
