# Generated by scripts/setup-hyprbars.sh from packaging/hyprland/jugoo_hyprbars.conf.in.
# Title bars: drag to move, double click = maximize, buttons ✕ □ —.

plugin = @PLUGIN@

plugin {
    hyprbars {
        bar_height = 28
        bar_color = rgba(161b26f2)
        col.text = rgb(dfe3ee)
        bar_text_size = 10
        bar_text_font = Sans
        bar_text_align = left
        bar_padding = 10
        bar_button_padding = 8
        bar_part_of_window = true
        bar_precedence_over_border = true
        inactive_button_color = rgba(3a4154ff)
        on_double_click = @VENTANAS@ max

        # Right to left.
        hyprbars-button = rgb(e5484d), 14, ✕, @VENTANAS@ close, rgb(ffffff)
        hyprbars-button = rgb(46a758), 14, □, @VENTANAS@ max, rgb(ffffff)
        hyprbars-button = rgb(e2a336), 14, —, @VENTANAS@ minimize, rgb(ffffff)
    }
}

# Clases que ya traen sus botones. Lo reescribe el daemon de ventanas.
source = ~/.config/hypr/config/jugoo_hyprbars_csd.conf

windowrule {
    name = jugoo-shell-sin-barra
    match:class = ^(com\.jugoo\.Shell)$
    hyprbars:no_bar = true
}
