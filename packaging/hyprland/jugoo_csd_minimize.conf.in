# Generated by packaging/hyprland/setup-csd-minimize.sh
# Intercepts Cursor/Chrome/Electron CSD caption buttons and routes them to
# ventanas — Hyprland ignores those buttons otherwise.
#
# Call ventanas.py directly (not the FIFO wrapper): caption clicks must not
# race a busy daemon, or Chrome/Firefox look like maximize “does nothing”.

plugin = @PLUGIN@

plugin {
    csd-minimize {
        command = python3 @VENTANAS@.py minimize
        maximize_command = python3 @VENTANAS@.py csd-max
        unmaximize_command = python3 @VENTANAS@.py unmax
        # Leave fullscreen empty so real F11 stays native.
        fullscreen_command =
    }
}
