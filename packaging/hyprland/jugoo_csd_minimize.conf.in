# Generated by packaging/hyprland/setup-csd-minimize.sh
# Intercepts Cursor/Chrome/Electron CSD minimize buttons and routes them to
# ventanas — Hyprland ignores those buttons otherwise.
#
# Maximize / unmaximize stay NATIVE (Hyprland mode 1 under the Jugoo bar).
# Routing set_maximized through `ventanas up` made Chrome re-expand on every
# click after □, and desynced the xdg maximized state (□ looked wrong / F11-ish).

plugin = @PLUGIN@

plugin {
    csd-minimize {
        command = @VENTANAS@ minimize
        maximize_command =
        unmaximize_command =
        # Leave fullscreen empty so F11 / true fullscreen stays native.
        fullscreen_command =
    }
}
