#!/bin/sh
# Send a command to the running `ventanas.py daemon` (no Python start-up per
# key press); fall back to a one-shot run when the daemon is not up.
dir="${XDG_RUNTIME_DIR:-/tmp}"
fifo="$dir/jugoo-ventanas.fifo"
if [ -p "$fifo" ] && read -r pid 2>/dev/null <"$dir/jugoo-ventanas.pid" && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$*" 1<>"$fifo"
    exit 0
fi
exec python3 "$(dirname "$0")/ventanas.py" "$@"
