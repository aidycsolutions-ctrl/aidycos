[Desktop Entry]
Type=Application
Name=OnlyOffice
Name[es]=OnlyOffice
Comment=Abrir OnlyOffice o descargarlo desde Flathub
Comment[es]=Abrir OnlyOffice o descargarlo desde Flathub
Exec=aidycos-onlyoffice %U
Icon=org.onlyoffice.desktopeditors
Terminal=false
Categories=Office;WordProcessor;Spreadsheet;Presentation;
Keywords=office;documentos;onlyoffice;flatpak;
MimeType=application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.spreadsheet;application/vnd.oasis.opendocument.presentation;application/pdf;text/csv;text/plain;
StartupNotify=true
StartupWMClass=ONLYOFFICE
Actions=new-window;

[Desktop Action new-window]
Name=Nueva ventana
Name[es]=Nueva ventana
Exec=aidycos-onlyoffice --new:word
