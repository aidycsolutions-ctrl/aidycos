#!/bin/sh
set -eu
# Prefer a user overlay (aidycos-update may land fixes here before /opt is writable).
USER_OVERLAY="${HOME}/.local/share/aidycos/aidylink-overlay"
if [ -d "${USER_OVERLAY}/aidylink" ]; then
  export PYTHONPATH="${USER_OVERLAY}:/opt/aidyc/aidylink${PYTHONPATH:+:$PYTHONPATH}"
else
  export PYTHONPATH=/opt/aidyc/aidylink${PYTHONPATH:+:$PYTHONPATH}
fi
# -P keeps the current directory from hiding the overlay. `python -m` otherwise
# inserts cwd first, and this script used to cd into /opt/aidyc/aidylink.
exec python3 -P -m aidylink "$@"
