#!/bin/sh
set -eu

# Prefer the system-managed checkout so aidycos-update always takes effect.
# If the user tree already has newer AidyCOS bar modules not yet in /opt
# (e.g. hostname widget before a sudo deploy), use the user tree temporarily.
USER_JUGOO="${HOME}/.local/share/aidycos/jugoo"
OPT_JUGOO=/opt/aidyc/jugoo

if [ -f "${USER_JUGOO}/shell/widgets/barra/host_identity.py" ] \
  && [ ! -f "${OPT_JUGOO}/shell/widgets/barra/host_identity.py" ]; then
  JUGOO_DIR="${USER_JUGOO}"
elif [ -f "${OPT_JUGOO}/.aidycos-managed" ] && [ -d "${OPT_JUGOO}/shell" ]; then
  JUGOO_DIR="${OPT_JUGOO}"
elif [ -d "${USER_JUGOO}/shell" ]; then
  JUGOO_DIR="${USER_JUGOO}"
else
  JUGOO_DIR="${OPT_JUGOO}"
fi

BOOT="${HOME}/.local/share/aidycos/patches/jugoo_aidycos_boot.py"
# Do not inherit a polluted PYTHONPATH from a previous session.
export PYTHONPATH="${JUGOO_DIR}"
cd "${JUGOO_DIR}"
if [ -f "$BOOT" ]; then
  exec python3 "$BOOT" "$@"
fi
exec python3 -m shell "$@"
