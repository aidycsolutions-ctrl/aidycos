#!/bin/sh
set -eu

# Prefer the writable AidyCOS user overlay; fall back to the system tree.
if [ -d "${HOME}/.local/share/aidycos/jugoo/shell" ]; then
  JUGOO_DIR="${HOME}/.local/share/aidycos/jugoo"
else
  JUGOO_DIR=/opt/aidyc/jugoo
fi
# Do not inherit a polluted PYTHONPATH from a previous /opt session.
export PYTHONPATH="${JUGOO_DIR}"
cd "${JUGOO_DIR}"
exec python3 -m shell "$@"
