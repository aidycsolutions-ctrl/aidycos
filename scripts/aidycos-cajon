#!/usr/bin/env python3
"""Abre el cajón de la XPRINTER desde AidyCOS, sin recompilar AidyC.

    aidycos-cajon
    python3 scripts/aidycos-cajon
    python3 scripts/aidycos-cajon --dry-run

Escribe el pulso ESC/POS directo en el nodo del kernel ``usblp``
(``/dev/usb/lp0``, o ``/dev/usb/lp1`` si el puerto cambia)::

    1B 70 00 19 FA

No usa ``lp``, ``sudo`` ni libusb: en el chip STMicroelectronics 0483:070b
esas vías dejan el endpoint en STALL. ``--dry-run`` no envía nada.
"""
from __future__ import annotations

import argparse
import fcntl
import glob
import logging
import os
import re
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path

logger = logging.getLogger("aidycos.cajon")

DRAWER_QUEUE = "XPRINTER"
DRAWER_PIN = 0
# ESC p m t1 t2: pin 2 (m=0), 25×2 ms activo, 250×2 ms en reposo.
# Pulso estable en la Xprinter 0483:070b por /dev/usb/lp*.
DRAWER_PULSE = bytes((0x1B, 0x70, 0x00, 0x19, 0xFA))
DRAWER_DEVICES = ("/dev/usb/lp0", "/dev/usb/lp1")
DRAWER_WRITE_TIMEOUT = 0.4
_CUPS_BIN_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin")
_OFFICE_PRINTER_RE = re.compile(r"hp[_\- ]?smart[_\- ]?tank|hewlett", re.IGNORECASE)
# Un pulso son 5 bytes. Una factura es mucho más grande. Por debajo de esto
# no es un ticket: es el propio cajón, y volver a abrirlo atasca la cola.
PULSE_JOB_MAX = 64
_JOB_HEAD_RE = re.compile(r"^(\S+-\d+)\s+\S+\s+(\d+)\b")
_META_LINE_RE = re.compile(
    r"^(?:alerts|alertas|status|estado|queued for|en cola para)\b",
    re.IGNORECASE,
)
# El pulso del propio cajón y las páginas de prueba no deben volver a abrirlo.
_SKIP_TITLE_RE = re.compile(
    r"open drawer|caj[oó]n|p[aá]gina de prueba|test page|\btest\b|\bprueba\b",
    re.IGNORECASE,
)


def is_office_printer(name: str | None) -> bool:
    return bool(_OFFICE_PRINTER_RE.search(str(name or "")))


def cups_tool(name: str) -> str:
    found = shutil.which(name)
    if found:
        return found
    for directory in _CUPS_BIN_DIRS:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return name


def resolve_drawer_printer(printer_name: str | None, available: list[str]) -> str:
    """Cola del cajón. Nunca la HP, aunque sea la predeterminada."""
    canonical = DRAWER_QUEUE
    for name in available:
        if str(name).lower() == DRAWER_QUEUE.lower():
            canonical = str(name)
            break
    requested = str(printer_name or "").strip()
    if requested and is_office_printer(requested):
        logger.error("Se ignoró %s; el cajón sale por %s", requested, canonical)
        return canonical
    if requested:
        return requested
    return canonical


def list_printers() -> list[str]:
    try:
        result = subprocess.run(
            [cups_tool("lpstat"), "-a"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.error("No se pudo enumerar impresoras: %s", error)
        return []
    if result.returncode != 0:
        return []
    names: list[str] = []
    for line in (result.stdout or "").splitlines():
        text = line.strip()
        if not text:
            continue
        name = text.split()[0]
        if name and name not in names:
            names.append(name)
    return names


def drawer_device_candidates(device: str | None = None) -> list[str]:
    """Puerto pedido, o lp0 y si no aparece lp1 (u otro ``/dev/usb/lp*``)."""
    requested = device if device is not None else os.environ.get("AIDYCOS_CASH_DRAWER_DEVICE", "")
    requested = str(requested or "").strip()
    if requested:
        return [requested]
    ordered: list[str] = []
    for path in (*DRAWER_DEVICES, *sorted(glob.glob("/dev/usb/lp*"))):
        if path not in ordered:
            ordered.append(path)
    present = [path for path in ordered if os.path.exists(path)]
    return present or list(DRAWER_DEVICES)


def _write_pulse(path: str, payload: bytes, timeout: float) -> tuple[bool, str]:
    """Abre el nodo, escribe y cierra. No bloquea más de ``timeout`` segundos."""
    fd = -1
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return False, f"{path} no existe"
    except OSError as error:
        return False, f"{path}: {error.strerror or error}"
    try:
        remaining = timeout
        offset = 0
        while offset < len(payload):
            if remaining <= 0:
                return False, f"{path} no aceptó el pulso en {timeout:.2f}s"
            started = time.monotonic()
            try:
                _readable, writable, exceptional = select.select([], [fd], [fd], remaining)
            except (OSError, ValueError) as error:
                return False, f"{path}: {error}"
            remaining -= time.monotonic() - started
            if exceptional and not writable:
                return False, f"{path} no está listo"
            if not writable:
                return False, f"{path} no aceptó el pulso en {timeout:.2f}s"
            try:
                written = os.write(fd, payload[offset:])
            except BlockingIOError:
                remaining -= 0.01
                time.sleep(0.01)
                continue
            except OSError as error:
                return False, f"{path}: {error.strerror or error}"
            if written <= 0:
                return False, f"{path} no escribió el pulso"
            offset += written
        return True, path
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError as error:
                logger.error("No se pudo cerrar %s: %s", path, error)


def openCashDrawer(
    device: str | None = None,
    *,
    timeout: float = DRAWER_WRITE_TIMEOUT,
    dry_run: bool = False,
    pulse: bytes | None = None,
) -> tuple[bool, str]:
    """Escribe el pulso ESC/POS en ``/dev/usb/lp*``.

    Un puerto apagado, ausente o en STALL se registra y devuelve ``False``.
    No lanza: la venta puede seguir.
    """
    try:
        payload = DRAWER_PULSE if pulse is None else pulse
        candidates = drawer_device_candidates(device)
        target = candidates[0] if candidates else DRAWER_DEVICES[0]
        if dry_run:
            logger.info("Prueba en seco: no se abre el cajón en %s", target)
            return True, f"dry-run {target}"
        errors: list[str] = []
        for index, path in enumerate(candidates):
            opened, detail = _write_pulse(path, payload, timeout)
            if opened:
                logger.info("Cajón abierto puerto=%s pin=%s", path, DRAWER_PIN)
                return True, path
            errors.append(detail)
            if index + 1 < len(candidates):
                logger.warning("Cajón: %s; se prueba otro puerto", detail)
        message = "; ".join(errors) or "no hay puerto usblp"
        logger.error("No se pudo abrir el cajón: %s", message)
        return False, message
    except Exception as error:
        logger.exception("No se pudo abrir el cajón")
        return False, str(error)


def open_drawer(
    printer_name: str | None = None,
    *,
    available: list[str] | None = None,
    dry_run: bool = False,
    device: str | None = None,
    timeout: float = DRAWER_WRITE_TIMEOUT,
    run=None,
) -> tuple[bool, str]:
    """Abre el cajón por usblp. No llama a ``lp`` ni a ``sudo``.

    ``printer_name``, ``available`` y ``run`` se conservan para quien ya
    llamaba esta función; el pulso ya no entra a una cola CUPS.
    """
    del available, run
    if printer_name and is_office_printer(printer_name):
        message = f"Se rechazó {printer_name}; el cajón sale por {DRAWER_DEVICES[0]}"
        logger.error(message)
        return False, message
    return openCashDrawer(device=device, timeout=timeout, dry_run=dry_run)


def parse_completed_jobs(text: str) -> list[tuple[str, int, str]]:
    """Lee ``lpstat``. Cada item es (línea de id, bytes, título)."""
    jobs: list[tuple[str, int, str]] = []
    header = ""
    size = 0
    extras: list[str] = []

    def flush() -> None:
        nonlocal header, size, extras
        if header:
            title = ""
            for line in extras:
                if _META_LINE_RE.match(line):
                    continue
                title = line
                break
            jobs.append((header, size, title))
        header = ""
        size = 0
        extras = []

    for raw in text.splitlines():
        if raw.startswith(("\t", " ")):
            if header:
                extras.append(raw.strip())
            continue
        flush()
        stripped = raw.strip()
        match = _JOB_HEAD_RE.match(stripped)
        if match:
            header = stripped
            size = int(match.group(2))
    flush()
    return jobs


def should_open_after_print(title: str, size: int = PULSE_JOB_MAX + 1) -> bool:
    """Una factura sí abre el cajón. El pulso y la página de prueba, no."""
    if size <= PULSE_JOB_MAX:
        return False
    return _SKIP_TITLE_RE.search(str(title or "").strip()) is None


def kicks_for_new_jobs(
    seen: set[str] | None,
    jobs: list[tuple[str, int, str]],
) -> tuple[set[str], list[tuple[str, int, str]]]:
    """La primera lectura solo recuerda trabajos ya impresos."""
    keys = {key for key, _size, _title in jobs}
    if seen is None:
        return keys, []
    fresh = [
        (key, size, title)
        for key, size, title in jobs
        if key not in seen and should_open_after_print(title, size)
    ]
    return seen | keys, fresh


def _lpstat(queue: str, *extra: str, run=None) -> str:
    sender = run or subprocess.run
    try:
        result = sender(
            [cups_tool("lpstat"), *extra, "-o", queue],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.error("No se pudo consultar %s: %s", queue, error)
        return ""
    return result.stdout or ""


def completed_jobs_text(queue: str = DRAWER_QUEUE, *, run=None) -> str:
    # Sin -l: no pide el detalle de todo el historial en cada vuelta.
    return _lpstat(queue, "-W", "completed", run=run)


def queue_is_idle(queue: str, *, run=None) -> bool:
    """True cuando no hay una factura ocupando la XPRINTER."""
    return not _lpstat(queue, run=run).strip()


def is_pulse_job(title: str, size: int) -> bool:
    """El trabajo de la captura: «Open Drawer», en proceso o pendiente, a veces con 0k."""
    if re.search(r"open drawer|caj[oó]n", str(title or ""), re.IGNORECASE):
        return True
    return 0 < size <= PULSE_JOB_MAX


def cancel_pulse_jobs(queue: str, *, run=None) -> list[str]:
    """Quita los Open Drawer ya encolados, también si CUPS los muestra en 0k."""
    sender = run or subprocess.run
    pending = parse_completed_jobs(_lpstat(queue, "-l", run=run))
    removed: list[str] = []
    for header, size, title in pending:
        if not is_pulse_job(title, size):
            continue
        job_id = header.split()[0]
        try:
            sender(
                [cups_tool("cancel"), "-x", job_id],
                capture_output=True,
                text=True,
                timeout=8,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            logger.error("No se pudo cancelar %s: %s", job_id, error)
            continue
        removed.append(job_id)
        logger.info("Se quitó el pulso encolado %s para no frenar la impresión", job_id)
    if removed and run is None:
        try:
            subprocess.run(
                [cups_tool("cupsenable"), queue],
                capture_output=True,
                text=True,
                timeout=8,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            logger.error("No se pudo reactivar %s: %s", queue, error)
    return removed


def submit_pulse(queue: str = DRAWER_QUEUE) -> None:
    """Escribe el pulso en usblp y vuelve. No usa ``lp`` ni espera a CUPS."""
    del queue
    opened, detail = openCashDrawer()
    if not opened:
        logger.error("El pulso tras imprimir no salió: %s", detail)


def watch_prints(queue: str = DRAWER_QUEUE, *, interval: float = 0.4) -> int:
    """Abre el cajón cuando la factura ya salió y la cola está libre."""
    lock_path = Path.home() / ".local" / "share" / "aidycos" / "cajon-watch.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        logger.info("El vigilante del cajón ya está corriendo")
        return 0
    cancel_pulse_jobs(queue)
    seen: set[str] | None = None
    pending = False
    last_pulse = 0.0
    logger.info("Vigilando impresiones de %s sin interrumpir la cola", queue)
    while True:
        seen, fresh = kicks_for_new_jobs(seen, parse_completed_jobs(completed_jobs_text(queue)))
        if fresh:
            pending = True
        if pending and queue_is_idle(queue) and (time.time() - last_pulse) > 1.5:
            submit_pulse(queue)
            pending = False
            last_pulse = time.time()
            logger.info("Cajón abierto después de imprimir")
        time.sleep(interval)


def command_path() -> Path:
    """Copia este archivo a ~/.local/bin para no seguir ejecutando una versión vieja."""
    source = Path(__file__).resolve()
    target = Path.home() / ".local" / "bin" / "aidycos-cajon"
    if source != target:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        target.chmod(0o755)
        return target
    return source


def ensure_session_config(text: str, command: str) -> str:
    """Añade F6 y el vigilante. No duplica el atajo si ya apunta a este comando."""
    bind = f"bind = , F6, exec, {command}"
    watch = f"exec-once = {command} watch"
    bind_re = re.compile(r"(?m)^[ \t]*bind[ \t]*=[ \t]*,[ \t]*F6,[ \t]*exec,.*$")
    watch_re = re.compile(r"(?m)^[ \t]*exec-once[ \t]*=[ \t]*.*aidycos-cajon(?:\s+watch)?[ \t]*$")
    if bind_re.search(text):
        text = bind_re.sub(bind, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += bind + "\n"
    if watch_re.search(text):
        text = watch_re.sub(watch, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += watch + "\n"
    return text


def install_session(conf_path: Path | None = None) -> int:
    """Deja F6 y la apertura tras imprimir en la sesión actual."""
    command = str(command_path())
    conf = conf_path or (Path.home() / ".config" / "hypr" / "aidycos.conf")
    conf.parent.mkdir(parents=True, exist_ok=True)
    current = conf.read_text(encoding="utf-8") if conf.is_file() else ""
    updated = ensure_session_config(current, command)
    if updated != current:
        conf.write_text(updated, encoding="utf-8")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], check=False, timeout=5)
    # El vigilante viejo sigue encolando pulsos. Hay que pararlo antes de arrancar este.
    subprocess.run(["pkill", "-f", "aidycos-cajon watch"], check=False)
    time.sleep(0.3)
    subprocess.Popen(
        [command, "watch"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(f"F6 y vigilante listos ({command})")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Abre el cajón de la XPRINTER por /dev/usb/lp*.")
    parser.add_argument(
        "--printer",
        default="",
        help="Nombre legado. Si es una impresora de oficina, el pulso se rechaza.",
    )
    parser.add_argument(
        "--device",
        default="",
        help="Nodo usblp. Por defecto /dev/usb/lp0 y, si no está, /dev/usb/lp1.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="No envía el pulso. Úsalo al probar; no abre el cajón.",
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=("watch", "install-session", "clear"),
        help="watch: abrir tras cada factura. clear: borrar Open Drawer atascados. install-session: atajo F6.",
    )
    parser.add_argument("conf", nargs="?", help="hyprland aidycos.conf, solo con install-session.")
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    if args.action == "clear":
        removed = cancel_pulse_jobs(args.printer or DRAWER_QUEUE)
        print("quitados=" + (",".join(removed) if removed else "-"))
        return 0
    if args.action == "watch":
        return watch_prints(args.printer or DRAWER_QUEUE)
    if args.action == "install-session":
        conf = Path(args.conf).expanduser() if args.conf else None
        return install_session(conf)
    opened, detail = open_drawer(
        args.printer or None,
        dry_run=args.dry_run,
        device=args.device or None,
    )
    print(detail)
    return 0 if opened else 1


if __name__ == "__main__":
    raise SystemExit(main())
