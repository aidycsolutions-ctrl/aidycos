#!/usr/bin/env python3
"""Abre el cajón de la XPRINTER desde AidyCOS, sin recompilar AidyC.

    aidycos-cajon
    python3 scripts/aidycos-cajon
    python3 scripts/aidycos-cajon --dry-run

Manda el pulso que ya abrió el cajón en Debian::

    printf '\\033\\160\\001\\045\\372' | lp -d XPRINTER -o raw

No toca la cola de las facturas ni la HP Smart Tank. ``--dry-run`` no envía nada.
"""
from __future__ import annotations

import argparse
import fcntl
import logging
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

logger = logging.getLogger("aidycos.cajon")

DRAWER_QUEUE = "XPRINTER"
DRAWER_PIN = 1
# printf '\033\160\001\045\372' → ESC p, pin 1, pulso 37, reposo 250.
DRAWER_PULSE = bytes((27, 112, DRAWER_PIN, 0o045, 0o372))
_CUPS_BIN_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin")
_OFFICE_PRINTER_RE = re.compile(r"hp[_\- ]?smart[_\- ]?tank|hewlett", re.IGNORECASE)
_JOB_ID_RE = re.compile(
    r"(?:request id is|id de solicitud es|identificador de solicitud es)\s+(\S+)",
    re.IGNORECASE,
)
_BAD_JOB_RE = re.compile(
    r"abort|cancel|held|stopped|abortad|cancelad|retenid",
    re.IGNORECASE,
)
_JOB_HEAD_RE = re.compile(r"^(\S+-\d+)\s+\S+")
_META_LINE_RE = re.compile(
    r"^(?:alerts|alertas|status|estado|queued for|en cola para)\b",
    re.IGNORECASE,
)
# El pulso del propio cajón y las páginas de prueba no deben volver a abrirlo.
_SKIP_TITLE_RE = re.compile(
    r"open drawer|caj[oó]n|p[aá]gina de prueba|test page|\btest\b|\bprueba\b",
    re.IGNORECASE,
)


def is_office_printer(name: str | None) -> bool:
    return bool(_OFFICE_PRINTER_RE.search(str(name or "")))


def cups_tool(name: str) -> str:
    found = shutil.which(name)
    if found:
        return found
    for directory in _CUPS_BIN_DIRS:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return name


def resolve_drawer_printer(printer_name: str | None, available: list[str]) -> str:
    """Cola del cajón. Nunca la HP, aunque sea la predeterminada."""
    canonical = DRAWER_QUEUE
    for name in available:
        if str(name).lower() == DRAWER_QUEUE.lower():
            canonical = str(name)
            break
    requested = str(printer_name or "").strip()
    if requested and is_office_printer(requested):
        logger.error("Se ignoró %s; el cajón sale por %s", requested, canonical)
        return canonical
    if requested:
        return requested
    return canonical


def list_printers() -> list[str]:
    try:
        result = subprocess.run(
            [cups_tool("lpstat"), "-a"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.error("No se pudo enumerar impresoras: %s", error)
        return []
    if result.returncode != 0:
        return []
    names: list[str] = []
    for line in (result.stdout or "").splitlines():
        text = line.strip()
        if not text:
            continue
        name = text.split()[0]
        if name and name not in names:
            names.append(name)
    return names


def confirm_cups_job(
    printer_name: str,
    completed: subprocess.CompletedProcess[str],
    *,
    run=None,
) -> str:
    output = f"{completed.stdout or ''}\n{completed.stderr or ''}"
    if completed.returncode != 0:
        raise RuntimeError(output.strip() or f"lp terminó con código {completed.returncode}")
    match = _JOB_ID_RE.search(output)
    if not match:
        raise RuntimeError(f"CUPS no confirmó el trabajo: {output.strip()}")
    job_id = match.group(1).strip("().,")
    queue = job_id.rsplit("-", 1)[0]
    if queue.lower() != printer_name.lower():
        raise RuntimeError(f"CUPS aceptó {job_id} en lugar de {printer_name}")
    if is_office_printer(queue):
        raise RuntimeError(f"El trabajo cayó en la impresora de oficina {queue}")
    sender = run or subprocess.run
    try:
        status = sender(
            [cups_tool("lpstat"), "-W", "not-completed", "-l", "-o", job_id],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.warning("No se pudo consultar %s: %s", job_id, error)
        return job_id
    detail = f"{status.stdout or ''}\n{status.stderr or ''}"
    if _BAD_JOB_RE.search(detail):
        raise RuntimeError(f"Trabajo {job_id} no completó: {detail.strip()}")
    return job_id


def open_drawer(
    printer_name: str | None = None,
    *,
    available: list[str] | None = None,
    dry_run: bool = False,
    run=None,
) -> tuple[bool, str]:
    """Envía el pulso. Con ``dry_run`` no llama a CUPS (sirve para pruebas)."""
    names = list_printers() if available is None else list(available)
    target = resolve_drawer_printer(printer_name, names)
    if is_office_printer(target):
        message = f"Se rechazó {target}; el cajón solo sale por {DRAWER_QUEUE}"
        logger.error(message)
        return False, message
    if dry_run:
        logger.info("Prueba en seco: no se abre el cajón de %s", target)
        return True, f"dry-run {target}"
    sender = run or subprocess.run
    try:
        completed = sender(
            [cups_tool("lp"), "-d", target, "-o", "raw", "-t", "Open Drawer"],
            input=DRAWER_PULSE,
            capture_output=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.error("No se pudo ejecutar lp: %s", error)
        return False, str(error)
    if not isinstance(completed.stdout, str):
        completed = subprocess.CompletedProcess(
            args=getattr(completed, "args", ()),
            returncode=completed.returncode,
            stdout=(completed.stdout or b"").decode("utf-8", "replace"),
            stderr=(completed.stderr or b"").decode("utf-8", "replace"),
        )
    try:
        job_id = confirm_cups_job(target, completed, run=sender)
    except RuntimeError as error:
        logger.error(
            "Cajón rechazado printer=%s rc=%s stdout=%s stderr=%s",
            target,
            completed.returncode,
            (completed.stdout or "").strip(),
            (completed.stderr or "").strip(),
        )
        return False, str(error)
    logger.info("Cajón abierto cola=%s pin=%s trabajo=%s", target, DRAWER_PIN, job_id)
    return True, job_id


def parse_completed_jobs(text: str) -> list[tuple[str, str]]:
    """Lee ``lpstat -W completed -l``. Cada item es (línea de id, título)."""
    jobs: list[tuple[str, str]] = []
    header = ""
    extras: list[str] = []

    def flush() -> None:
        nonlocal header, extras
        if header:
            title = ""
            for line in extras:
                if _META_LINE_RE.match(line):
                    continue
                title = line
                break
            jobs.append((header, title))
        header = ""
        extras = []

    for raw in text.splitlines():
        if raw.startswith(("\t", " ")):
            if header:
                extras.append(raw.strip())
            continue
        flush()
        stripped = raw.strip()
        if _JOB_HEAD_RE.match(stripped):
            header = stripped
    flush()
    return jobs


def should_open_after_print(title: str) -> bool:
    """Una factura sí abre el cajón. El pulso y la página de prueba, no."""
    return _SKIP_TITLE_RE.search(str(title or "").strip()) is None


def kicks_for_new_jobs(
    seen: set[str] | None,
    jobs: list[tuple[str, str]],
) -> tuple[set[str], list[tuple[str, str]]]:
    """La primera lectura solo recuerda trabajos ya impresos."""
    keys = {key for key, _title in jobs}
    if seen is None:
        return keys, []
    fresh = [
        (key, title)
        for key, title in jobs
        if key not in seen and should_open_after_print(title)
    ]
    return seen | keys, fresh


def completed_jobs_text(queue: str = DRAWER_QUEUE) -> str:
    try:
        result = subprocess.run(
            [cups_tool("lpstat"), "-W", "completed", "-l", "-o", queue],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        logger.error("No se pudieron leer los trabajos de %s: %s", queue, error)
        return ""
    return result.stdout or ""


def watch_prints(queue: str = DRAWER_QUEUE, *, interval: float = 1.0) -> int:
    """Tras cada factura en la XPRINTER, abre el cajón una vez."""
    lock_path = Path.home() / ".local" / "share" / "aidycos" / "cajon-watch.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        logger.info("El vigilante del cajón ya está corriendo")
        return 0
    seen: set[str] | None = None
    logger.info("Vigilando impresiones de %s", queue)
    while True:
        seen, fresh = kicks_for_new_jobs(seen, parse_completed_jobs(completed_jobs_text(queue)))
        if fresh:
            opened, detail = open_drawer(queue)
            logger.info("Tras imprimir %s: %s", fresh[-1][1] or fresh[-1][0], detail)
            if not opened:
                logger.error("No se abrió el cajón tras imprimir: %s", detail)
        time.sleep(interval)


def command_path() -> Path:
    """Ruta sin espacios: la de /usr/local/bin o una copia en ~/.local/bin."""
    system = Path("/usr/local/bin/aidycos-cajon")
    if system.is_file() and os.access(system, os.X_OK):
        return system
    target = Path.home() / ".local" / "bin" / "aidycos-cajon"
    source = Path(__file__).resolve()
    if source != target.resolve():
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        target.chmod(0o755)
    return target


def ensure_session_config(text: str, command: str) -> str:
    """Añade F6 y el vigilante. No duplica el atajo si ya apunta a este comando."""
    bind = f"bind = , F6, exec, {command}"
    watch = f"exec-once = {command} watch"
    bind_re = re.compile(r"(?m)^[ \t]*bind[ \t]*=[ \t]*,[ \t]*F6,[ \t]*exec,.*$")
    watch_re = re.compile(r"(?m)^[ \t]*exec-once[ \t]*=[ \t]*.*aidycos-cajon(?:\s+watch)?[ \t]*$")
    if bind_re.search(text):
        text = bind_re.sub(bind, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += bind + "\n"
    if watch_re.search(text):
        text = watch_re.sub(watch, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += watch + "\n"
    return text


def install_session(conf_path: Path | None = None) -> int:
    """Deja F6 y la apertura tras imprimir en la sesión actual."""
    command = str(command_path())
    conf = conf_path or (Path.home() / ".config" / "hypr" / "aidycos.conf")
    conf.parent.mkdir(parents=True, exist_ok=True)
    current = conf.read_text(encoding="utf-8") if conf.is_file() else ""
    updated = ensure_session_config(current, command)
    if updated != current:
        conf.write_text(updated, encoding="utf-8")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], check=False, timeout=5)
    subprocess.Popen(
        [command, "watch"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(f"F6 y vigilante listos ({command})")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Abre el cajón de la XPRINTER por CUPS raw.")
    parser.add_argument("--printer", default="", help="Cola CUPS. Por defecto XPRINTER.")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="No envía el pulso. Úsalo al probar; no abre el cajón.",
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=("watch", "install-session"),
        help="watch: abrir tras cada factura. install-session: atajo F6 y vigilante.",
    )
    parser.add_argument("conf", nargs="?", help="hyprland aidycos.conf, solo con install-session.")
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    if args.action == "watch":
        return watch_prints(args.printer or DRAWER_QUEUE)
    if args.action == "install-session":
        conf = Path(args.conf).expanduser() if args.conf else None
        return install_session(conf)
    opened, detail = open_drawer(args.printer or None, dry_run=args.dry_run)
    print(detail)
    return 0 if opened else 1


if __name__ == "__main__":
    raise SystemExit(main())
