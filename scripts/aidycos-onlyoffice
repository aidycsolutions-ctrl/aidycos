#!/usr/bin/env bash
# Launch OnlyOffice Desktop Editors, or install it from Flathub on first use.
set -euo pipefail

APP_ID="${AIDYCOS_ONLYOFFICE_FLATPAK:-org.onlyoffice.desktopeditors}"
REMOTE="${AIDYCOS_FLATPAK_REMOTE:-flathub}"
REMOTE_URL="${AIDYCOS_FLATPAK_REMOTE_URL:-https://dl.flathub.org/repo/flathub.flatpakrepo}"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "OnlyOffice" -i x-office-document "$1" "$2" || true
  else
    printf '%s: %s\n' "$1" "$2" >&2
  fi
}

# Jugoo appends --new-window on another desktop; OnlyOffice wants --new:word.
ARGS=()
for arg in "$@"; do
  case "${arg}" in
    --new-window|--new-instance) ARGS+=(--new:word) ;;
    *) ARGS+=("${arg}") ;;
  esac
done
set -- "${ARGS[@]}"

# Prefer a native .deb / PATH binary when Flatpak is missing or broken.
try_native() {
  local bin
  for bin in onlyoffice-desktopeditors desktopeditors onlyoffice; do
    if command -v "${bin}" >/dev/null 2>&1; then
      exec "${bin}" "$@"
    fi
  done
  return 1
}

ensure_flathub() {
  if flatpak remote-list --columns=name 2>/dev/null | grep -qx "${REMOTE}"; then
    return 0
  fi
  if flatpak remote-add --user --if-not-exists "${REMOTE}" "${REMOTE_URL}"; then
    return 0
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec flatpak remote-add --if-not-exists "${REMOTE}" "${REMOTE_URL}" || true
  fi
  flatpak remote-list --columns=name 2>/dev/null | grep -qx "${REMOTE}"
}

already_installed() {
  command -v flatpak >/dev/null 2>&1 || return 1
  flatpak info --user "${APP_ID}" >/dev/null 2>&1 \
    || flatpak info "${APP_ID}" >/dev/null 2>&1
}

confirm_install() {
  local message
  message="OnlyOffice no está instalado todavía.

¿Quieres descargarlo desde Flathub ahora?
Necesitas Internet; la primera descarga puede tardar unos minutos."
  if command -v zenity >/dev/null 2>&1 && { [[ -n "${DISPLAY:-}" ]] || [[ -n "${WAYLAND_DISPLAY:-}" ]]; }; then
    zenity --question --title="Instalar OnlyOffice" --width=420 --text="${message}"
    return $?
  fi
  if [[ -t 0 ]]; then
    printf '%s\n' "${message}"
    read -r -p "Escribe S para instalar: " answer
    [[ "${answer}" == [sS] || "${answer}" == [sS][iíIÍ] ]]
    return $?
  fi
  # Desktop icon click without zenity: proceed (notify) instead of silent fail.
  notify "OnlyOffice" "Descargando OnlyOffice desde Flathub (primera vez)…"
  return 0
}

schedule_focus() {
  # When OnlyOffice is already running, the second launch hands the file to the
  # existing process and exits. Hyprland must still raise that window.
  if ! command -v hyprctl >/dev/null 2>&1; then
    return 0
  fi
  nohup bash -c '
    for _ in 1 2 3 4 5 6 7 8; do
      sleep 0.25
      if hyprctl clients -j 2>/dev/null | grep -Eqi "\"class\": \"ONLYOFFICE\""; then
        hyprctl dispatch focuswindow "class:^(ONLYOFFICE)$" >/dev/null 2>&1 || true
        hyprctl dispatch alterzorder top,"class:^(ONLYOFFICE)$" >/dev/null 2>&1 || true
        exit 0
      fi
    done
  ' >/dev/null 2>&1 &
}

run_onlyoffice() {
  schedule_focus
  local -a cmd=(flatpak run)
  if flatpak info --user "${APP_ID}" >/dev/null 2>&1; then
    cmd+=(--user)
  fi
  cmd+=(--command=desktopeditors)
  local has_files=0
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --*) ;;
      *) has_files=1; break ;;
    esac
  done
  if ((has_files)); then
    # Match Flathub desktop: forward paths into the sandbox for open-with.
    cmd+=(--file-forwarding "${APP_ID}" @@u "$@" @@)
  else
    cmd+=("${APP_ID}" "$@")
  fi
  exec "${cmd[@]}"
}

if already_installed; then
  run_onlyoffice "$@"
fi

# Native .deb before requiring Flatpak.
if try_native "$@"; then
  exit 0
fi

if ! command -v flatpak >/dev/null 2>&1; then
  notify "OnlyOffice" "Falta Flatpak. Ábrelo desde Instalar paquetes (Synaptic) o vuelve a actualizar AidyCOS."
  exit 1
fi

ensure_flathub || {
  notify "OnlyOffice" "No se pudo añadir el remoto Flathub."
  exit 1
}

confirm_install || {
  notify "OnlyOffice" "Instalación cancelada. Vuelve a abrir OnlyOffice para instalarlo."
  exit 0
}

notify "OnlyOffice" "Descargando OnlyOffice desde Flathub…"
if flatpak install -y --user "${REMOTE}" "${APP_ID}"; then
  notify "OnlyOffice" "Instalación terminada. Abriendo OnlyOffice…"
  run_onlyoffice "$@"
fi

if command -v pkexec >/dev/null 2>&1 && pkexec flatpak install -y "${REMOTE}" "${APP_ID}"; then
  notify "OnlyOffice" "Instalación terminada. Abriendo OnlyOffice…"
  run_onlyoffice "$@"
fi

notify "OnlyOffice" "No se pudo instalar OnlyOffice. Revisa la conexión o usa Instalar paquetes."
exit 1
