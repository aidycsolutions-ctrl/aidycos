#!/usr/bin/env bash
set -euo pipefail

REPO="aidycsolutions-ctrl/aidycos"
BRANCH="main"
DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
MARKER="${DATA_HOME}/aidycos/github-commit"
LOCK="${DATA_HOME}/aidycos/update-check.lock"
ACTION="${1:---check}"

case "${ACTION}" in
  --check) ;;
  -h|--help)
    echo "Uso: aidycos-update [--check]"
    echo "Comprueba GitHub y pregunta antes de aplicar un perfil nuevo."
    exit 0
    ;;
  *) echo "Opción desconocida: ${ACTION}" >&2; exit 2 ;;
esac

gui_available() {
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]
}

import_environ_from_pid() {
  local pid="$1"
  local env_file="/proc/${pid}/environ"
  local entry key value
  [[ -r "${env_file}" ]] || return 1
  while IFS= read -r -d '' entry; do
    [[ "${entry}" == *=* ]] || continue
    key="${entry%%=*}"
    value="${entry#*=}"
    case "${key}" in
      WAYLAND_DISPLAY|DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|HYPRLAND_INSTANCE_SIGNATURE)
        if [[ -z "${!key:-}" && -n "${value}" ]]; then
          export "${key}=${value}"
        fi
        ;;
    esac
  done <"${env_file}"
}

# systemd user units and .desktop launches often lack Wayland vars.
ensure_session_env() {
  if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${DISPLAY:-}" ]]; then
    return 0
  fi

  local line key value pid
  while IFS= read -r line; do
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "${key}" in
      WAYLAND_DISPLAY|DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|HYPRLAND_INSTANCE_SIGNATURE)
        if [[ -z "${!key:-}" && -n "${value}" ]]; then
          export "${key}=${value}"
        fi
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)

  if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${DISPLAY:-}" ]]; then
    for pid in $(pgrep -u "$(id -u)" -x Hyprland 2>/dev/null || true); do
      import_environ_from_pid "${pid}" || true
    done
  fi

  if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local sock
    sock="$(find "${XDG_RUNTIME_DIR}/hypr" -maxdepth 2 -type s -name '.socket.sock' 2>/dev/null | head -n1 || true)"
    if [[ -n "${sock}" ]]; then
      export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "${sock}")")"
      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
    fi
  fi
}

notify_error() {
  local text="$1"
  echo "${text}" >&2
  if command -v zenity >/dev/null 2>&1 && gui_available; then
    zenity --error --title="AidyCOS" --text="${text}" --width=420 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "${text}" || true
  fi
}

notify_info() {
  local text="$1"
  echo "${text}"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "${text}" || true
  fi
}

find_terminal() {
  local name path
  for name in foot kitty alacritty gnome-terminal kgx xfce4-terminal x-terminal-emulator xterm; do
    path="$(command -v "${name}" 2>/dev/null || true)"
    if [[ -n "${path}" ]]; then
      printf '%s\n' "${path}"
      return 0
    fi
  done
  return 1
}

# Open the password terminal immediately. Never download before this returns.
# Important: pass a single executable path to hyprctl. Shell-quoted command
# strings from printf %q look like success but foot never starts.
run_in_terminal() {
  local terminal="$1"
  local script_path="$2"
  local launcher="$3"
  local started=0

  ensure_session_env

  cat >"${launcher}" <<EOF
#!/usr/bin/env bash
exec $(printf '%q' "${terminal}") bash $(printf '%q' "${script_path}")
EOF
  chmod 700 "${launcher}"

  # 1) Ask Hyprland to spawn a real window in the live session.
  if command -v hyprctl >/dev/null 2>&1; then
    if hyprctl dispatch exec -- "${launcher}" >/dev/null 2>&1; then
      started=1
    fi
  fi

  # 2) Direct spawn when this process already has a graphical session.
  if [[ "${started}" != 1 ]] && gui_available; then
    nohup "${launcher}" >/dev/null 2>&1 &
    disown || true
    started=1
  fi

  if [[ "${started}" != 1 ]]; then
    return 1
  fi

  # hyprctl returns success when the dispatch is queued, even if the binary
  # fails later. Confirm a child is actually running the apply script.
  local i
  for i in 1 2 3 4 5 6 7 8; do
    if pgrep -u "$(id -u)" -f "bash ${script_path}" >/dev/null 2>&1 \
      || pgrep -u "$(id -u)" -f "${script_path}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done

  # Last resort only when this process already owns a visible TTY.
  if [[ -t 0 && -t 1 ]]; then
    bash "${script_path}"
    return 0
  fi
  return 1
}

mkdir -p "$(dirname "${LOCK}")"
exec 9>"${LOCK}"
if ! flock -n 9; then
  echo "Ya hay una comprobación o actualización de AidyCOS en curso."
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "Ya hay una actualización en curso." || true
  fi
  exit 0
fi

ensure_session_env

if ! command -v curl >/dev/null 2>&1; then
  notify_error "No se encontró curl; instala curl para comprobar actualizaciones."
  exit 127
fi

# Immediate feedback: GitHub can take several seconds and used to look "dead".
if gui_available && command -v notify-send >/dev/null 2>&1; then
  notify-send -a AidyCOS "AidyCOS" "Comprobando actualizaciones en GitHub…" || true
fi

release_json="$(curl --fail --silent --show-error --location \
  --connect-timeout 10 --max-time 30 \
  -H 'Accept: application/vnd.github+json' \
  -H 'User-Agent: AidyCOS-updater' \
  "https://api.github.com/repos/${REPO}/commits/${BRANCH}")" || {
    notify_error "No se pudo consultar GitHub. Comprueba tu conexión e inténtalo de nuevo."
    exit 1
  }
latest="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])' <<<"${release_json}")"
subject="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("commit",{}).get("message","").splitlines()[0])' <<<"${release_json}")"
current=""
[[ ! -r "${MARKER}" ]] || current="$(cat "${MARKER}")"

if [[ -z "${latest}" ]]; then
  notify_error "GitHub no devolvió el identificador de la versión actual."
  exit 1
fi
if [[ "${latest}" == "${current}" ]]; then
  if [[ -t 0 ]]; then
    echo "AidyCOS está actualizado (${latest:0:8})."
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "Ya está actualizado (${latest:0:8})." || true
  fi
  exit 0
fi

message="Hay una actualización de AidyCOS disponible (${latest:0:8})."
[[ -z "${subject}" ]] || message+=$'\n\n'"${subject}"
message+=$'\n\n'"¿Quieres descargarla y aplicar el perfil ahora? Se abrirá una terminal para la contraseña de administrador."
accept=0
if command -v zenity >/dev/null 2>&1 && gui_available; then
  zenity --question --title="Actualización de AidyCOS" --text="${message}" --width=460 && accept=1 || true
elif [[ -t 0 ]]; then
  printf '%s\n' "${message}" "Escribe S para actualizar: "
  read -r answer
  [[ "${answer,,}" == "s" || "${answer,,}" == "si" || "${answer,,}" == "sí" ]] && accept=1
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -a AidyCOS "Actualización disponible" \
    "Abre «Actualizar AidyCOS» o pulsa Super+Shift+U para revisar ${latest:0:8}."
  exit 0
else
  echo "${message}" >&2
  echo "Ejecuta aidycos-update desde una terminal para confirmar." >&2
  exit 0
fi

if [[ "${accept}" != 1 ]]; then
  echo "Actualización pospuesta. Puedes iniciarla después con aidycos-update."
  exit 0
fi

# Open feedback immediately: write a tiny runner and spawn the terminal BEFORE
# any tarball download. The slow curl lives inside that window.
apply_dir="$(mktemp -d "${TMPDIR:-/tmp}/aidycos-update.XXXXXX")"
apply_script="${apply_dir}/apply.sh"
terminal_launcher="${apply_dir}/launch-terminal.sh"
cat >"${apply_script}" <<EOF
#!/usr/bin/env bash
set -euo pipefail
REPO=$(printf '%q' "${REPO}")
LATEST=$(printf '%q' "${latest}")
MARKER=$(printf '%q' "${MARKER}")
WORKDIR=$(printf '%q' "${apply_dir}")

cleanup() {
  rm -rf "\${WORKDIR}"
}
trap cleanup EXIT

echo "Actualización de AidyCOS"
echo "========================"
echo "Descargando revisión \${LATEST:0:8}…"
archive="\${WORKDIR}/aidycos.tar.gz"
curl --fail --show-error --location \
  --connect-timeout 10 --max-time 180 \
  "https://codeload.github.com/\${REPO}/tar.gz/\${LATEST}" -o "\${archive}"
echo "Descarga terminada. Preparando instalador…"
tar -xzf "\${archive}" -C "\${WORKDIR}"
source_dir="\$(find "\${WORKDIR}" -mindepth 1 -maxdepth 1 -type d -print -quit)"
installer="\${source_dir}/scripts/install-debian-profile.sh"
if [[ ! -x "\${installer}" ]]; then
  echo "La revisión descargada no contiene el instalador del perfil." >&2
  echo
  read -r -p "Pulsa Enter para cerrar esta ventana…" _
  exit 1
fi

echo "Aplicando el perfil. Escribe tu contraseña cuando se pida…"
bash "\${installer}" --no-reboot
mkdir -p "\$(dirname "\${MARKER}")"
printf '%s\\n' "\${LATEST}" >"\${MARKER}"
echo
echo "AidyCOS quedó actualizado."
echo "Atajos y Alt+Tab se recargan en caliente; si algo de la sesión no cambia, cierra sesión una vez."
echo
read -r -p "Pulsa Enter para cerrar esta ventana…" _
EOF
chmod 700 "${apply_script}"

# Manual interactive shell: reuse this TTY. GUI/menu/timer always open a window.
if [[ -t 0 && -t 1 && -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  bash "${apply_script}"
  exit 0
fi
if [[ -t 0 && -t 1 && "${AIDYCOS_UPDATE_INLINE:-}" == 1 ]]; then
  bash "${apply_script}"
  exit 0
fi

terminal="$(find_terminal || true)"
if [[ -z "${terminal}" ]]; then
  notify_error "No hay una terminal instalada para pedir la contraseña. Instala foot (o kitty/alacritty) y vuelve a ejecutar aidycos-update."
  rm -rf "${apply_dir}"
  exit 1
fi

# Release the flock before handing off so later checks are not blocked.
exec 9>&-

if ! run_in_terminal "${terminal}" "${apply_script}" "${terminal_launcher}"; then
  notify_error "No se pudo abrir la terminal para pedir la contraseña. Abre foot y ejecuta: aidycos-update"
  rm -rf "${apply_dir}"
  exit 1
fi

notify_info "Terminal abierta: la descarga y la contraseña van ahí."
exit 0
