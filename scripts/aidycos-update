#!/usr/bin/env bash
set -euo pipefail

REPO="aidycsolutions-ctrl/aidycos"
BRANCH="main"
DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
MARKER="${DATA_HOME}/aidycos/github-commit"
LOCK="${DATA_HOME}/aidycos/update-check.lock"
ACTION="${1:---check}"

case "${ACTION}" in
  --check) ;;
  -h|--help)
    echo "Uso: aidycos-update [--check]"
    echo "Comprueba GitHub y pregunta antes de aplicar un perfil nuevo."
    exit 0
    ;;
  *) echo "Opción desconocida: ${ACTION}" >&2; exit 2 ;;
esac

gui_available() {
  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]
}

import_environ_from_pid() {
  local pid="$1"
  local env_file="/proc/${pid}/environ"
  local entry key value
  [[ -r "${env_file}" ]] || return 1
  while IFS= read -r -d '' entry; do
    [[ "${entry}" == *=* ]] || continue
    key="${entry%%=*}"
    value="${entry#*=}"
    case "${key}" in
      WAYLAND_DISPLAY|DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|HYPRLAND_INSTANCE_SIGNATURE)
        if [[ -z "${!key:-}" && -n "${value}" ]]; then
          export "${key}=${value}"
        fi
        ;;
    esac
  done <"${env_file}"
}

# systemd user units and .desktop launches often lack Wayland vars.
ensure_session_env() {
  if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${DISPLAY:-}" ]]; then
    return 0
  fi

  local line key value pid
  while IFS= read -r line; do
    [[ "${line}" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "${key}" in
      WAYLAND_DISPLAY|DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|HYPRLAND_INSTANCE_SIGNATURE)
        if [[ -z "${!key:-}" && -n "${value}" ]]; then
          export "${key}=${value}"
        fi
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)

  if [[ -z "${WAYLAND_DISPLAY:-}" || -z "${DISPLAY:-}" ]]; then
    for pid in $(pgrep -u "$(id -u)" -x Hyprland 2>/dev/null || true); do
      import_environ_from_pid "${pid}" || true
    done
  fi

  if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local sock
    sock="$(find "${XDG_RUNTIME_DIR}/hypr" -maxdepth 2 -type s -name '.socket.sock' 2>/dev/null | head -n1 || true)"
    if [[ -n "${sock}" ]]; then
      export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "${sock}")")"
      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
    fi
  fi
}

notify_error() {
  local text="$1"
  echo "${text}" >&2
  if command -v zenity >/dev/null 2>&1 && gui_available; then
    zenity --error --title="AidyCOS" --text="${text}" --width=420 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "${text}" || true
  fi
}

notify_info() {
  local text="$1"
  echo "${text}"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "${text}" || true
  fi
}

mkdir -p "$(dirname "${LOCK}")"
exec 9>"${LOCK}"
if ! flock -n 9; then
  echo "Ya hay una comprobación o actualización de AidyCOS en curso."
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "Ya hay una actualización en curso." || true
  fi
  exit 0
fi

ensure_session_env

if ! command -v curl >/dev/null 2>&1; then
  notify_error "No se encontró curl; instala curl para comprobar actualizaciones."
  exit 127
fi

# Immediate feedback: GitHub can take several seconds and used to look "dead".
if gui_available && command -v notify-send >/dev/null 2>&1; then
  notify-send -a AidyCOS "AidyCOS" "Comprobando actualizaciones en GitHub…" || true
fi

release_json="$(curl --fail --silent --show-error --location \
  --connect-timeout 10 --max-time 30 \
  -H 'Accept: application/vnd.github+json' \
  -H 'User-Agent: AidyCOS-updater' \
  "https://api.github.com/repos/${REPO}/commits/${BRANCH}")" || {
    notify_error "No se pudo consultar GitHub. Comprueba tu conexión e inténtalo de nuevo."
    exit 1
  }
latest="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])' <<<"${release_json}")"
subject="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("commit",{}).get("message","").splitlines()[0])' <<<"${release_json}")"
current=""
[[ ! -r "${MARKER}" ]] || current="$(cat "${MARKER}")"

if [[ -z "${latest}" ]]; then
  notify_error "GitHub no devolvió el identificador de la versión actual."
  exit 1
fi
if [[ "${latest}" == "${current}" ]]; then
  echo "AidyCOS está actualizado (${latest:0:8})."
  # The daily timer (systemd sets INVOCATION_ID) must stay quiet when nothing
  # changed. A manual menu/shortcut launch still gets one notification.
  if [[ -z "${INVOCATION_ID:-}" && ! -t 0 ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "Ya está actualizado (${latest:0:8})." || true
  fi
  exit 0
fi

message="Hay una actualización de AidyCOS disponible (${latest:0:8})."
[[ -z "${subject}" ]] || message+=$'\n\n'"${subject}"
message+=$'\n\n'"¿Quieres descargarla y aplicar el perfil ahora?"
accept=0
if command -v zenity >/dev/null 2>&1 && gui_available; then
  zenity --question --title="Actualización de AidyCOS" \
    --text="${message}"$'\n\n'"Solo se pedirá la contraseña; la descarga y la instalación siguen en segundo plano." \
    --width=460 && accept=1 || true
elif [[ -t 0 ]]; then
  printf '%s\n' "${message}" "Escribe S para actualizar: "
  read -r answer
  [[ "${answer,,}" == "s" || "${answer,,}" == "si" || "${answer,,}" == "sí" ]] && accept=1
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -a AidyCOS "Actualización disponible" \
    "Abre «Actualizar AidyCOS» o pulsa Super+Shift+U para revisar ${latest:0:8}."
  exit 0
else
  echo "${message}" >&2
  echo "Ejecuta aidycos-update desde una terminal para confirmar." >&2
  exit 0
fi

if [[ "${accept}" != 1 ]]; then
  echo "Actualización pospuesta. Puedes iniciarla después con aidycos-update."
  exit 0
fi

# Ask for the password with a dialog, then download and apply out of sight.
# A real TTY without a graphical session still runs inline in that terminal.
apply_dir="$(mktemp -d "${TMPDIR:-/tmp}/aidycos-update.XXXXXX")"
apply_script="${apply_dir}/apply.sh"
askpass="${apply_dir}/askpass.sh"
pass_file="${apply_dir}/sudo-pass"
sudo_wrap_dir="${apply_dir}/bin"
log_file="${DATA_HOME}/aidycos/update.log"
gui_apply=0
if gui_available && [[ "${AIDYCOS_UPDATE_INLINE:-}" != 1 ]]; then
  gui_apply=1
fi

mkdir -p "${sudo_wrap_dir}" "$(dirname "${log_file}")"
real_sudo="$(command -v sudo || true)"
cat >"${askpass}" <<EOF
#!/bin/sh
# Replay the password already confirmed in the dialog. One prompt for the whole update.
if [ -s $(printf '%q' "${pass_file}") ]; then
  cat $(printf '%q' "${pass_file}")
  exit 0
fi
exec zenity --password \\
  --title="Actualizar AidyCOS" \\
  --text="Contraseña de administrador. La actualización sigue en segundo plano."
EOF
cat >"${sudo_wrap_dir}/sudo" <<EOF
#!/bin/sh
exec $(printf '%q' "${real_sudo:-/usr/bin/sudo}") -A "\$@"
EOF
chmod 700 "${askpass}" "${sudo_wrap_dir}/sudo"

cat >"${apply_script}" <<EOF
#!/usr/bin/env bash
set -euo pipefail
trap '' HUP
REPO=$(printf '%q' "${REPO}")
LATEST=$(printf '%q' "${latest}")
MARKER=$(printf '%q' "${MARKER}")
WORKDIR=$(printf '%q' "${apply_dir}")
LOCK=$(printf '%q' "${LOCK}")
LOG=$(printf '%q' "${log_file}")
ASKPASS=$(printf '%q' "${askpass}")
PASSFILE=$(printf '%q' "${pass_file}")
SUDO_WRAP=$(printf '%q' "${sudo_wrap_dir}")
GUI_APPLY=$(printf '%q' "${gui_apply}")
REAL_SUDO=$(printf '%q' "${real_sudo}")

refresh_pid=""
cleanup() {
  if [[ -n "\${refresh_pid}" ]]; then
    kill "\${refresh_pid}" 2>/dev/null || true
    wait "\${refresh_pid}" 2>/dev/null || true
  fi
  rm -rf "\${WORKDIR}"
}
trap cleanup EXIT

report_failure() {
  local text="\$1"
  echo "\${text}" >&2
  if [[ "\${GUI_APPLY}" == 1 ]] && command -v zenity >/dev/null 2>&1; then
    local detail
    detail="\$(tail -n 12 "\${LOG}" 2>/dev/null || true)"
    if [[ -n "\${detail}" ]]; then
      text+=\$'\n\n'"\${detail}"
    fi
    zenity --error --title="AidyCOS" --text="\${text}" --width=480 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "\${text}" || true
  fi
}

exec 9>"\${LOCK}"
if ! flock -n 9; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "Ya hay una actualización en curso." || true
  fi
  exit 0
fi

run_update() {
  echo "Actualización de AidyCOS"
  echo "Descargando revisión \${LATEST:0:8}…"
  local archive source_dir installer
  archive="\${WORKDIR}/aidycos.tar.gz"
  curl --fail --show-error --location \
    --connect-timeout 10 --max-time 180 \
    "https://codeload.github.com/\${REPO}/tar.gz/\${LATEST}" -o "\${archive}" || return 1
  echo "Descarga terminada. Preparando instalador…"
  tar -xzf "\${archive}" -C "\${WORKDIR}" || return 1
  source_dir="\$(find "\${WORKDIR}" -mindepth 1 -maxdepth 1 -type d -print -quit)"
  installer="\${source_dir}/scripts/install-debian-profile.sh"
  if [[ ! -x "\${installer}" ]]; then
    echo "La revisión descargada no contiene el instalador del perfil." >&2
    return 1
  fi
  echo "Aplicando el perfil…"
  bash "\${installer}" --no-reboot || return 1
  mkdir -p "\$(dirname "\${MARKER}")"
  printf '%s\\n' "\${LATEST}" >"\${MARKER}"
  echo "AidyCOS quedó actualizado."
}

if [[ "\${GUI_APPLY}" == 1 ]]; then
  if [[ -z "\${REAL_SUDO}" || ! -x "\${ASKPASS}" ]]; then
    report_failure "No se pudo preparar el diálogo de contraseña."
    exit 1
  fi
  if ! command -v zenity >/dev/null 2>&1; then
    report_failure "Hace falta zenity para pedir la contraseña sin abrir una consola."
    exit 1
  fi
  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a
  export APT_LISTCHANGES_FRONTEND=none
  # One dialog. The ticket covers later sudo calls; the saved password covers
  # the ones that do not see that ticket because there is no terminal.
  if ! "\${REAL_SUDO}" -n true 2>/dev/null; then
    confirmed=0
    for _attempt in 1 2 3; do
      password="\$(zenity --password --title="Actualizar AidyCOS" --text="Contraseña de administrador. La actualización sigue en segundo plano.")" || {
        if command -v notify-send >/dev/null 2>&1; then
          notify-send -a AidyCOS "AidyCOS" "Actualización cancelada." || true
        fi
        exit 1
      }
      if printf '%s\\n' "\${password}" | "\${REAL_SUDO}" -S -p '' -v >/dev/null 2>&1; then
        confirmed=1
        break
      fi
      zenity --warning --title="AidyCOS" --text="Contraseña incorrecta." --width=360 || true
    done
    if [[ "\${confirmed}" != 1 ]]; then
      if command -v notify-send >/dev/null 2>&1; then
        notify-send -a AidyCOS "AidyCOS" "No se confirmó la contraseña. Actualización cancelada." || true
      fi
      exit 1
    fi
    umask 077
    printf '%s\\n' "\${password}" >"\${PASSFILE}"
    chmod 600 "\${PASSFILE}"
    unset password
  fi
  export SUDO_ASKPASS="\${ASKPASS}"
  export PATH="\${SUDO_WRAP}:\${PATH}"
  ( while true; do sleep 60; "\${REAL_SUDO}" -n -v 2>/dev/null || exit 0; done ) &
  refresh_pid=\$!
  : >"\${LOG}"
  if ! run_update >>"\${LOG}" 2>&1; then
    report_failure "No se pudo actualizar AidyCOS."
    exit 1
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a AidyCOS "AidyCOS" "AidyCOS quedó actualizado. Si algún atajo no cambia, cierra sesión una vez." || true
  fi
  exit 0
fi

run_update
echo "Atajos y Alt+Tab se recargan en caliente; si algo de la sesión no cambia, cierra sesión una vez."
EOF
chmod 700 "${apply_script}"

if [[ "${gui_apply}" != 1 ]]; then
  bash "${apply_script}"
  exit 0
fi

if ! command -v zenity >/dev/null 2>&1; then
  notify_error "Hace falta zenity para pedir la contraseña sin abrir una consola."
  rm -rf "${apply_dir}"
  exit 1
fi

# The background job takes the lock. Release it here so that job can start.
exec 9>&-
if command -v setsid >/dev/null 2>&1; then
  setsid bash "${apply_script}" </dev/null >/dev/null 2>&1 &
else
  nohup bash "${apply_script}" </dev/null >/dev/null 2>&1 &
fi
disown || true
notify_info "Actualizando AidyCOS en segundo plano. Si hace falta, escribe la contraseña en la ventana que aparece."
exit 0
